# Copier en .env puis remplir. Ne jamais versionner le .env.
# Ce fichier ne contient que les secrets et ce qui dépend de la machine.
# Tout le reste (labels, conventions, projets, modèles, mode d'action) se règle
# dans le dashboard : http://localhost:4321/#settings

# --- GitLab ---
GITLAB_URL=https://gitlab.example.com
# Token d'accès perso : Avatar > Edit profile > Access tokens
# Scopes : api, read_repository, write_repository. Mettre une date d'expiration.
# Les commentaires, approbations, branches et MR sont faits en TON nom.
GITLAB_TOKEN=
# Ton nom d'utilisateur GitLab (sert à trouver les MR où tu es reviewer)
GITLAB_USERNAME=
POLL_INTERVAL_SEC=90

# --- Claude ---
# Les agents passent par la CLI Claude Code connectée à TON abonnement (pas de clé API).
# Vérifier la connexion : claude auth status
# Chemin de la CLI (par défaut ~/.local/bin/claude s'il existe, sinon "claude" du PATH)
# CLAUDE_BIN=

# --- Serveur (écoute en local uniquement) ---
HOST=127.0.0.1
PORT=4321
DATA_DIR=./data

# --- Planio (phase 3, pas encore utilisé) ---
# PLANIO_URL=https://example.plan.io
# PLANIO_API_KEY=
