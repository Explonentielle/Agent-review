{
  "name": "review-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agent perso de code review GitLab (et support Planio) piloté par Claude",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "review:once": "tsx --env-file=.env src/cli/reviewOnce.ts",
    "typecheck": "tsc --noEmit",
    "db:import": "tsx src/cli/importSqlite.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
